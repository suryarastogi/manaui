{
  "name": "@manaui/core",
  "version": "0.1.0",
  "description": "Framework-free Magic: The Gathering helpers: Scryfall card types, mana cost parsing, card art URLs and the timing logic behind manaui's card previews.",
  "license": "MIT",
  "author": "Surya Rastogi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suryarastogi/manaui.git",
    "directory": "packages/core"
  },
  "homepage": "https://suryarastogi.github.io/manaui/",
  "keywords": [
    "mtg",
    "magic-the-gathering",
    "scryfall",
    "mana",
    "shadcn"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.compat.json"
  },
  "devDependencies": {
    "@scryfall/api-types": "1.0.0-alpha.4",
    "tsdown": "^0.23.7",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
